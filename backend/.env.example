# ---------------------------------------------------------------------------
# CampusShare (csmju-campus-share) — ตัวอย่าง environment
# คัดลอกเป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)
# ชื่อตัวแปรทุกตัวตรงกับ src/config/configuration.ts + src/config/env.validation.ts
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4205

# deployment.md 4.1 — จำกัด connection ต่อระบบ (PostgreSQL กลางใช้ร่วม 37 ระบบ)
DATABASE_POOL_MAX=5

# tech-stack.md 1.4.1 — งานตั้งเวลาต้องอยู่เขตเวลาไทย
TZ=Asia/Bangkok

# ฐานข้อมูลของ subsystem นี้เท่านั้น — ห้ามชี้ไปที่ core_hub
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/csmju_campus_share_db?schema=public

# ตัวตนของ subsystem — ต้องตรงกับ name ใน subsystem.yaml เป๊ะ
SUBSYSTEM_ID=csmju-campus-share

# origin ที่เบราว์เซอร์เห็น (frontend Next.js ที่ proxy มาหา backend)
# ต้องตรงกับ base_url ใน subsystem.yaml และ callback_url ที่ลงทะเบียนกับ Core Hub
PUBLIC_ORIGIN=http://localhost:3205

# Core Hub — ชื่อตัวแปรตรงกับตารางใน standards/docs/deployment.md ข้อ 4.2
# (server ตั้งค่าเหล่านี้ให้ตอนรัน · DevOps อ่านรายการ env จากไฟล์นี้)
CORE_HUB_URL=http://localhost:3000
CORE_HUB_WEB_URL=http://localhost:3000
CORE_HUB_JWKS_URL=http://localhost:3000/api/v1/.well-known/jwks.json

# สัญญาที่ตรึงไว้ — ห้ามเปลี่ยนเอง (contracts/jwt-contract.json)
CORE_HUB_ISSUER=core-hub
CORE_HUB_AUDIENCE=csmju2030

# JWKS cache / เวลา
CORE_HUB_JWKS_CACHE_TTL_MS=600000
CORE_HUB_JWKS_MIN_REFRESH_INTERVAL_MS=30000
CORE_HUB_JWKS_REQUEST_TIMEOUT_MS=5000
CORE_HUB_CLOCK_TOLERANCE_SEC=60

# code ของสาขาที่ระบบนี้ให้บริการ (reference-data.md ข้อ 4: ^[A-Z0-9-]+$)
# `computer-science` ถูกเปลี่ยนเป็น `CS` ก่อนมาตรฐาน 1.7.0 (reference-data.md ข้อ 9)
DEPARTMENT_CODE=CS
